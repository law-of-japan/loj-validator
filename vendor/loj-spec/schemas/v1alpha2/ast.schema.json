{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://law-of-japan.github.io/loj-spec/schemas/v1alpha2/ast.schema.json",
  "$comment": "Canonical identifier only; publication at this URI is not required.",
  "title": "LoJ semantic AST loj/v1alpha2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "loj/v1alpha2"
    },
    "law": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "constitution",
            "act",
            "cabinetOrder",
            "imperialOrder",
            "ministerialOrdinance",
            "rule",
            "ordinance",
            "other"
          ]
        },
        "number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "promulgatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "const": "ja"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "number",
        "promulgatedAt",
        "language"
      ],
      "additionalProperties": false
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "schemaVersion",
    "law",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Law",
            "MainProvision",
            "Part",
            "Chapter",
            "Section",
            "Subsection",
            "Division",
            "Article",
            "Paragraph",
            "Item",
            "Subitem",
            "SupplementaryProvision",
            "AppendedMaterial",
            "EnactStatement",
            "Preamble",
            "Table",
            "Row",
            "Cell"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}(-[1-9][0-9]{0,3})*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          },
          "minItems": 0
        },
        "status": {
          "enum": [
            "active",
            "deleted"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "numbering": {
          "enum": [
            "explicit",
            "implicit"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-hjkmnp-tv-z]{4}$"
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "id",
        "number",
        "display",
        "content"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Article"
              }
            }
          },
          "then": {
            "required": [
              "status"
            ]
          },
          "else": {
            "not": {
              "required": [
                "status"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Subitem"
              }
            }
          },
          "then": {
            "required": [
              "level"
            ]
          },
          "else": {
            "not": {
              "required": [
                "level"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "Law",
                  "MainProvision",
                  "SupplementaryProvision",
                  "AppendedMaterial",
                  "EnactStatement",
                  "Preamble",
                  "Row"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "number": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "number": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,3}(-[1-9][0-9]{0,3})*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Paragraph"
              }
            }
          },
          "then": {
            "required": [
              "numbering"
            ]
          },
          "else": {
            "not": {
              "required": [
                "numbering"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Row"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          },
          "else": {
            "not": {
              "required": [
                "key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Cell"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rowspan"
                  ]
                },
                {
                  "required": [
                    "colspan"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "Table",
                  "Row",
                  "Cell",
                  "EnactStatement",
                  "Preamble"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "display": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "numbering": {
                "const": "implicit"
              }
            },
            "required": [
              "numbering"
            ]
          },
          "then": {
            "properties": {
              "display": {
                "const": ""
              }
            }
          }
        }
      ]
    }
  }
}
