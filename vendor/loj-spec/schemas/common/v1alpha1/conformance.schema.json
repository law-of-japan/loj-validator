{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://law-of-japan.github.io/loj-spec/schemas/common/v1alpha1/conformance.schema.json",
  "$comment": "Canonical identifier only; publication at this URI is not required.",
  "title": "LoJ conformance case index",
  "type": "object",
  "properties": {
    "suite": {
      "enum": [
        "loj/v1alpha2",
        "common/v1alpha1",
        "loj-history/v1alpha1",
        "loj-glyphs/v1alpha1",
        "loj-registry/v1alpha1",
        "loj-rebuild/v1alpha1"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pkg|common|hist|glyph|reg|rebuild)-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{2}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "check": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "registry",
              "rebuild",
              "change",
              "reference"
            ]
          },
          "category": {
            "enum": [
              "historyStructure",
              "evidence",
              "sourceMatch",
              "relationResolution",
              "relationConsistency",
              "timeConsistency",
              "clauseReference"
            ]
          },
          "normative": {
            "type": "boolean"
          },
          "input": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "package"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "repository"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "registry"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "records"
                  },
                  "registry": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  },
                  "repositories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "kind",
                  "registry",
                  "repositories"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "change"
                  },
                  "bundle": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  },
                  "base": {
                    "type": "string",
                    "minLength": 1
                  },
                  "head": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "bundle",
                  "base",
                  "head"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "reference"
                  },
                  "bundle": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  },
                  "registry": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "bundle",
                  "registry",
                  "reference"
                ],
                "additionalProperties": false
              }
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "requirements",
          "check",
          "normative",
          "input",
          "expected",
          "success"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "check": {
                  "enum": [
                    "L3",
                    "L4"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "category"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "category"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "suite",
    "cases"
  ],
  "additionalProperties": false
}
