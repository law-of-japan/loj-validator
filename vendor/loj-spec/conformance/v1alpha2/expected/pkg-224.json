              "content": [
                {
                  "kind": "Paragraph",
                  "id": "20990101-act-1/main/article/1/paragraph/1",
                  "number": "1",
                  "display": "",
                  "content": [
                    {
                      "text": "架空雲保険法（架空法律第八号）の一部を次のように改正する。\n"
                    },
                    {
                      "kind": "Amendment",
                      "id": "20990101-act-1/main/article/1/paragraph/1/amendment/1",
                      "number": "1",
                      "display": "",
                      "content": [
                        {
                          "kind": "AmendmentContent",
                          "id": "20990101-act-1/main/article/1/paragraph/1/amendment/1/content",
                          "number": null,
                          "display": "",
                          "content": [
                            {
                              "kind": "Article",
                              "id": "20990101-act-1/main/article/1/paragraph/1/amendment/1/content/article/4",
                              "number": "4",
                              "display": "第四條",
                              "content": [
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/1/paragraph/1/amendment/1/content/article/4/paragraph/1",
                                  "number": "1",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "雲保険ノ保険金額ハ被保険者一人ニ付二萬圓以下トス\n"
                                    }
                                  ],
                                  "numbering": "explicit"
                                }
                              ],
                              "status": "active"
                            }
                          ]
                        }
                      ],
                      "instruction": "implicit"
                    }
                  ],
                  "numbering": "explicit"
                }
              ],
              "status": "active"
            },
            {
              "kind": "Article",
              "id": "20990101-act-1/main/article/2",
              "number": "2",
              "display": "第二條",
              "content": [
                {
                  "kind": "Paragraph",
                  "id": "20990101-act-1/main/article/2/paragraph/1",
                  "number": "1",
                  "display": "",
                  "content": [
                    {
                      "text": "架空雲年金法（架空法律第九号）の一部を次のように改正する。\n"
                    },
                    {
                      "kind": "Amendment",
                      "id": "20990101-act-1/main/article/2/paragraph/1/amendment/1",
                      "number": "1",
                      "display": "",
                      "content": [
                        {
                          "kind": "AmendmentContent",
                          "id": "20990101-act-1/main/article/2/paragraph/1/amendment/1/content",
                          "number": null,
                          "display": "",
                          "content": [
                            {
                              "kind": "Article",
                              "id": "20990101-act-1/main/article/2/paragraph/1/amendment/1/content/article/3",
                              "number": "3",
                              "display": "第三條",
                              "content": [
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/2/paragraph/1/amendment/1/content/article/3/paragraph/1",
                                  "number": "1",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "雲年金ノ額ハ年金受取人一人ニ付年額二萬圓以下トス\n"
                                    }
                                  ],
                                  "numbering": "explicit"
                                }
                              ],
                              "status": "active"
                            }
                          ]
                        }
                      ],
                      "instruction": "implicit"
                    }
                  ],
                  "numbering": "explicit"
                }
              ],
              "status": "active"
            }
          ]
        },
        {
          "kind": "SupplementaryProvision",
          "id": "20990101-act-1/supplement/original",
          "number": null,
          "display": "附　則",
          "content": [
            {
              "kind": "Paragraph",
              "id": "20990101-act-1/supplement/original/paragraph/1",
              "number": "1",
              "display": "",
              "content": [
                {
                  "text": "この法律は、架空の日から、これを施行する。\n"
                }
              ],
              "numbering": "implicit"
            },
            {
              "kind": "Paragraph",
              "id": "20990101-act-1/supplement/original/paragraph/2",
              "number": "2",
              "display": "",
              "content": [
                {
                  "text": "この法律施行前の保険契約については、架空雲保険法第四條の改正規定にかかわらず、なお従前の規定による。\n"
                }
              ],
              "numbering": "implicit"
            }
          ]
        }
      ]
