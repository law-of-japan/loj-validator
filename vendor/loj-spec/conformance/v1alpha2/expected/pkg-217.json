          "content": [
            {
              "kind": "Article",
              "id": "20990101-act-1/main/article/14",
              "number": "14",
              "display": "第十四條",
              "content": [
                {
                  "kind": "Paragraph",
                  "id": "20990101-act-1/main/article/14/paragraph/1",
                  "number": "1",
                  "display": "",
                  "content": [
                    {
                      "text": "架空雲官制（架空勅令第一号）の一部を次のように改正する。\n第一條中「、白雲」を削る。\n第三條中「五局」を「三局」に改め、「雨雲局\n雪雲局」を削る。\n"
                    },
                    {
                      "kind": "Amendment",
                      "id": "20990101-act-1/main/article/14/paragraph/1/amendment/1",
                      "number": "1",
                      "display": "",
                      "content": [
                        {
                          "text": "第五條を次のように改める。\n"
                        },
                        {
                          "kind": "AmendmentContent",
                          "id": "20990101-act-1/main/article/14/paragraph/1/amendment/1/content",
                          "number": null,
                          "display": "",
                          "content": [
                            {
                              "kind": "Article",
                              "id": "20990101-act-1/main/article/14/paragraph/1/amendment/1/content/article/5",
                              "number": "5",
                              "display": "第五條",
                              "content": [
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/14/paragraph/1/amendment/1/content/article/5/paragraph/1",
                                  "number": "1",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "架空雲省に、大臣官房及び三局を置く。\n"
                                    }
                                  ],
                                  "numbering": "explicit"
                                }
                              ],
                              "status": "active"
                            }
                          ]
                        }
                      ],
                      "instruction": "explicit"
                    },
                    {
                      "kind": "Amendment",
                      "id": "20990101-act-1/main/article/14/paragraph/1/amendment/2",
                      "number": "2",
                      "display": "",
                      "content": [
                        {
                          "kind": "AmendmentContent",
                          "id": "20990101-act-1/main/article/14/paragraph/1/amendment/2/content",
                          "number": null,
                          "display": "",
                          "content": [
                            {
                              "kind": "Article",
                              "id": "20990101-act-1/main/article/14/paragraph/1/amendment/2/content/article/7",
                              "number": "7",
                              "display": "第七條",
                              "content": [],
                              "status": "deleted"
                            }
                          ]
                        }
                      ],
                      "instruction": "implicit"
                    },
                    {
                      "text": "第七條ノ二及び第七條ノ三を削る。\n"
                    },
                    {
