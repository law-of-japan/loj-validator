                              "number": "23",
                              "display": "第二十三條",
                              "content": [],
                              "status": "deleted"
                            }
                          ]
                        }
                      ],
                      "instruction": "implicit"
                    }
                  ],
                  "numbering": "explicit"
                }
              ],
              "status": "active"
            },
            {
              "kind": "Article",
              "id": "20990101-act-1/main/article/15",
              "number": "15",
              "display": "第十五條",
              "content": [
                {
                  "kind": "Paragraph",
                  "id": "20990101-act-1/main/article/15/paragraph/1",
                  "number": "1",
                  "display": "",
                  "content": [
                    {
                      "text": "架空雨量法（架空法律第二号）の一部を次のように改正する。\n"
                    },
                    {
                      "kind": "Amendment",
                      "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1",
                      "number": "1",
                      "display": "",
                      "content": [
                        {
                          "kind": "AmendmentContent",
                          "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1/content",
                          "number": null,
                          "display": "",
                          "content": [
                            {
                              "kind": "Article",
                              "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1/content/article/10-2",
                              "number": "10-2",
                              "display": "第十條の二",
                              "content": [
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1/content/article/10-2/paragraph/1",
                                  "number": "1",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "白雲局長は、雨量の記録について、必要な援助を与える。\n"
                                    }
                                  ],
                                  "numbering": "implicit"
                                },
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1/content/article/10-2/paragraph/2",
                                  "number": "2",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "白雲局長は、記録を閲覧せしめることができる。\n"
                                    }
                                  ],
                                  "numbering": "implicit"
                                },
                                {
                                  "kind": "Paragraph",
                                  "id": "20990101-act-1/main/article/15/paragraph/1/amendment/1/content/article/10-2/paragraph/3",
                                  "number": "3",
                                  "display": "",
                                  "content": [
                                    {
                                      "text": "第十一條の規定は、白雲局長について準用する。\n"
                                    }
                                  ],
                                  "numbering": "implicit"
                                }
                              ],
                              "status": "active"
                            }
                          ]
                        }
                      ],
                      "instruction": "implicit"
                    },
                    {
                      "text": "第十二條第一号中「第十條」を「第十條、第十條の二」に改める。\n"
                    }
                  ],
                  "numbering": "explicit"
                }
              ],
              "status": "active"
            }
          ]
        }
